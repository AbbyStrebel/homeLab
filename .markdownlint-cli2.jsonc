// markdownlint-cli2 config — lenient, docs-first.
{
  "config": {
    "default": true,
    "MD013": false,   // no hard line-length limit (prose + tables)
    "MD033": false,   // allow inline HTML if ever needed
    "MD041": false,   // first line need not be a top-level heading everywhere
    "MD060": false    // don't require table pipes to be visually aligned (wide tables)
  },
  "globs": ["**/*.md"],
  "ignores": [".venv", "node_modules"]
}
